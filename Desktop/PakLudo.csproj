<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\app_icon.ico</ApplicationIcon>
    <AssemblyName>PakLudo</AssemblyName>
    <RootNamespace>PakLudo</RootNamespace>
    <Version>1.0.1</Version>
    <Authors>Muhammad Adrees</Authors>
    <Company>Pak Ludo</Company>
    <Product>Pak Ludo</Product>
    <Description>Classic Ludo board game for Windows Desktop featuring Pakistani Emerald Green theme, AI bots, and local multiplayer.</Description>
    <Copyright>Copyright © 2026 Muhammad Adrees</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\app_icon.ico" />
    <Resource Include="Resources\favicon.png" />
  </ItemGroup>

</Project>
