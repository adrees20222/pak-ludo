<Window x:Class="PakLudo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:PakLudo.Views"
        mc:Ignorable="d"
        Title="Pak Ludo - Classic Board Game"
        Icon="Resources/app_icon.ico"
        Height="800" Width="1050"
        MinHeight="650" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">
    <Grid>
        <views:HomeScreen x:Name="HomeScreenView" Visibility="Visible" />
        <views:PlayerSetupScreen x:Name="PlayerSetupScreenView" Visibility="Collapsed" />
        <views:GameScreen x:Name="GameScreenView" Visibility="Collapsed" />
        <views:HowToPlayScreen x:Name="HowToPlayScreenView" Visibility="Collapsed" />
    </Grid>
</Window>
