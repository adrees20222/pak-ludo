<UserControl x:Class="PakLudo.Controls.VictoryDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="600">
    <Grid Background="#B0000000">
        <Border Width="480" MaxWidth="520" Background="White" CornerRadius="20"
                Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.4" Color="#000000" />
            </Border.Effect>

            <StackPanel HorizontalAlignment="Stretch">
                <!-- Trophy Icon & Title -->
                <TextBlock Text="🏆" FontSize="54" HorizontalAlignment="Center" Margin="0,0,0,8" />
                <TextBlock Text="Game Finished!" FontSize="28" FontWeight="Bold" Foreground="#01411C"
                           HorizontalAlignment="Center" Margin="0,0,0,4" />
                <TextBlock Text="Match Standings" FontSize="15" Foreground="#64748B"
                           HorizontalAlignment="Center" Margin="0,0,0,20" />

                <!-- Standings List -->
                <StackPanel x:Name="StandingsContainer" Margin="0,0,0,24" />

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="PlayAgainButton" Click="OnPlayAgainClicked"
                            Content="🔄 Play Again" FontSize="16" FontWeight="SemiBold"
                            Background="#01411C" Foreground="White" Padding="20,12" Margin="0,0,14,0"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10" />
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="HomeButton" Click="OnHomeClicked"
                            Content="🏠 Home Menu" FontSize="16" FontWeight="SemiBold"
                            Background="#F1F5F9" Foreground="#334155" Padding="20,12"
                            BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
