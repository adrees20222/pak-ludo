<UserControl x:Class="PakLudo.Controls.DiceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="120" d:DesignWidth="120">
    <UserControl.Resources>
        <Storyboard x:Key="RollShakeAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="DiceTransform" 
                             Storyboard.TargetProperty="Angle" 
                             From="-15" To="15" Duration="0:0:0.1" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="DiceScale" 
                             Storyboard.TargetProperty="ScaleX" 
                             From="0.9" To="1.1" Duration="0:0:0.1" AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="DiceScale" 
                             Storyboard.TargetProperty="ScaleY" 
                             From="0.9" To="1.1" Duration="0:0:0.1" AutoReverse="True" />
        </Storyboard>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Button x:Name="RollButton" Click="OnDiceClicked"
                Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="0">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter />
                </ControlTemplate>
            </Button.Template>

            <Border x:Name="DiceBorder" Width="80" Height="80" CornerRadius="16"
                    Background="White" BorderBrush="#01411C" BorderThickness="3"
                    RenderTransformOrigin="0.5,0.5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="4" Opacity="0.3" Color="#000000" />
                </Border.Effect>
                <Border.RenderTransform>
                    <TransformGroup>
                        <RotateTransform x:Name="DiceTransform" Angle="0" />
                        <ScaleTransform x:Name="DiceScale" ScaleX="1" ScaleY="1" />
                    </TransformGroup>
                </Border.RenderTransform>

                <Grid x:Name="PipsGrid" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Pips for 1 to 6 (Row 0, 1, 2 x Col 0, 1, 2) -->
                    <Ellipse x:Name="Pip_TL" Grid.Row="0" Grid.Column="0" Fill="#01411C" Width="14" Height="14" Visibility="Collapsed"/>
                    <Ellipse x:Name="Pip_TR" Grid.Row="0" Grid.Column="2" Fill="#01411C" Width="14" Height="14" Visibility="Collapsed"/>
                    <Ellipse x:Name="Pip_ML" Grid.Row="1" Grid.Column="0" Fill="#01411C" Width="14" Height="14" Visibility="Collapsed"/>
                    <Ellipse x:Name="Pip_MC" Grid.Row="1" Grid.Column="1" Fill="#01411C" Width="14" Height="14" Visibility="Collapsed"/>
                    <Ellipse x:Name="Pip_MR" Grid.Row="1" Grid.Column="2" Fill="#01411C" Width="14" Height="14" Visibility="Collapsed"/>
                    <Ellipse x:Name="Pip_BL" Grid.Row="2" Grid.Column="0" Fill="#01411C" Width="14" Height="14" Visibility="Collapsed"/>
                    <Ellipse x:Name="Pip_BR" Grid.Row="2" Grid.Column="2" Fill="#01411C" Width="14" Height="14" Visibility="Collapsed"/>

                    <TextBlock x:Name="PromptText" Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="3"
                               Text="ROLL" FontWeight="Bold" FontSize="18" Foreground="#01411C"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible"/>
                </Grid>
            </Border>
        </Button>
    </Grid>
</UserControl>
