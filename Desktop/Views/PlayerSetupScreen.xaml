<UserControl x:Class="PakLudo.Views.PlayerSetupScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F8FAFC">
        <StackPanel HorizontalAlignment="Center" MaxWidth="620" Margin="24,32,24,32">
            
            <!-- Header -->
            <TextBlock Text="🎲 Player Setup" FontSize="30" FontWeight="Bold" Foreground="#01411C"
                       HorizontalAlignment="Center" Margin="0,0,0,8" />
            <TextBlock Text="Configure players and AI bots for your match" FontSize="15" Foreground="#64748B"
                       HorizontalAlignment="Center" Margin="0,0,0,24" />

            <!-- Player Count Selection -->
            <Border Background="White" CornerRadius="16" Padding="20" Margin="0,0,0,20" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Select Number of Players" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12" />
                    <UniformGrid Columns="3" HorizontalAlignment="Stretch">
                        <RadioButton x:Name="Radio2Players" Content="2 Players" GroupName="PlayerCount"
                                     IsChecked="True" Checked="OnPlayerCountChanged"
                                     FontSize="15" FontWeight="SemiBold" Margin="4" Padding="12,10"
                                     HorizontalAlignment="Center" />
                        <RadioButton x:Name="Radio3Players" Content="3 Players" GroupName="PlayerCount"
                                     Checked="OnPlayerCountChanged"
                                     FontSize="15" FontWeight="SemiBold" Margin="4" Padding="12,10"
                                     HorizontalAlignment="Center" />
                        <RadioButton x:Name="Radio4Players" Content="4 Players" GroupName="PlayerCount"
                                     Checked="OnPlayerCountChanged"
                                     FontSize="15" FontWeight="SemiBold" Margin="4" Padding="12,10"
                                     HorizontalAlignment="Center" />
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Player Cards Container -->
            <StackPanel x:Name="PlayerInputsContainer" Margin="0,0,0,24" />

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Click="OnStartMatchClicked" Content="🚀 Start Match" FontSize="18" FontWeight="Bold"
                        Background="#01411C" Foreground="White" Padding="32,14" Margin="0,0,16,0"
                        BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12" />
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Click="OnBackClicked" Content="🏠 Back" FontSize="18" FontWeight="SemiBold"
                        Background="#F1F5F9" Foreground="#334155" Padding="24,14"
                        BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="12" />
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
