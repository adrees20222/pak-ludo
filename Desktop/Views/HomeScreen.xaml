<UserControl x:Class="PakLudo.Views.HomeScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#F8FAFC">
        <StackPanel HorizontalAlignment="Center" MaxWidth="840" Margin="24,32,24,32">
            
            <!-- Hero Card -->
            <Border CornerRadius="20" Padding="36,32" Margin="0,0,0,32">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#01411C" Offset="0.0" />
                        <GradientStop Color="#0D6E38" Offset="0.5" />
                        <GradientStop Color="#15803D" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="6" Opacity="0.25" Color="#000000" />
                </Border.Effect>

                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🎲" FontSize="60" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Text="PAK LUDO" FontSize="36" FontWeight="ExtraBold" Foreground="White"
                               HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="Classic Pakistani Emerald Green Board Game for Windows"
                               FontSize="16" Foreground="#E2E8F0" HorizontalAlignment="Center" Margin="0,0,0,24" />

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Click="OnPlayClicked" Content="🎮 Play Now" FontSize="18" FontWeight="Bold"
                                Background="White" Foreground="#01411C" Padding="28,14" Margin="0,0,16,0"
                                BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="12" />
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Click="OnHowToPlayClicked" Content="📜 How to Play" FontSize="18" FontWeight="SemiBold"
                                Background="#10FFFFFF" Foreground="White" Padding="24,14"
                                BorderBrush="White" BorderThickness="1.5" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="12" />
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Section Title: Available Everywhere -->
            <TextBlock Text="🎮 Available Everywhere" FontSize="22" FontWeight="Bold" Foreground="#0F172A"
                       Margin="0,0,0,14" />

            <!-- 2x2 Symmetrical Grid for Platforms -->
            <UniformGrid Columns="2" Margin="0,0,0,32">
                <!-- Web Version -->
                <Border CornerRadius="14" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                        Padding="18" Margin="6" Cursor="Hand" MouseLeftButtonDown="OnWebClicked">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.08" Color="#000000" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="🌐 Web Version" FontSize="17" FontWeight="Bold" Foreground="#01411C" Margin="0,0,0,4" />
                        <TextBlock Text="Play directly in any browser with zero installation on Blogger."
                                   FontSize="13" Foreground="#64748B" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Chrome Extension -->
                <Border CornerRadius="14" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                        Padding="18" Margin="6" Cursor="Hand" MouseLeftButtonDown="OnExtensionClicked">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.08" Color="#000000" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="🧩 Chrome Extension" FontSize="17" FontWeight="Bold" Foreground="#01411C" Margin="0,0,0,4" />
                        <TextBlock Text="Instant quick-launch popup extension for Chrome &amp; Edge browsers."
                                   FontSize="13" Foreground="#64748B" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Android App -->
                <Border CornerRadius="14" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                        Padding="18" Margin="6" Cursor="Hand" MouseLeftButtonDown="OnAndroidClicked">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.08" Color="#000000" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="📱 Android App (APK)" FontSize="17" FontWeight="Bold" Foreground="#01411C" Margin="0,0,0,4" />
                        <TextBlock Text="Download standalone APK with zero latency SoundPool sound."
                                   FontSize="13" Foreground="#64748B" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- GitHub Repo -->
                <Border CornerRadius="14" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                        Padding="18" Margin="6" Cursor="Hand" MouseLeftButtonDown="OnGitHubClicked">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.08" Color="#000000" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="⭐ GitHub Repository" FontSize="17" FontWeight="Bold" Foreground="#01411C" Margin="0,0,0,4" />
                        <TextBlock Text="Open source code, latest updates, and desktop installers."
                                   FontSize="13" Foreground="#64748B" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Section Title: Key Features -->
            <TextBlock Text="✨ Game Features" FontSize="22" FontWeight="Bold" Foreground="#0F172A"
                       Margin="0,0,0,14" />

            <!-- 2x2 Grid for Features -->
            <UniformGrid Columns="2" Margin="0,0,0,36">
                <Border CornerRadius="14" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                        Padding="18" Margin="6">
                    <StackPanel>
                        <TextBlock Text="⚡ Instant Play" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4" />
                        <TextBlock Text="No sign-ups. Open the game and jump straight into a match."
                                   FontSize="13" Foreground="#64748B" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border CornerRadius="14" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                        Padding="18" Margin="6">
                    <StackPanel>
                        <TextBlock Text="🚫 Zero Ads" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4" />
                        <TextBlock Text="No pop-ups, no unskippable videos between turns. Just the pure game."
                                   FontSize="13" Foreground="#64748B" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border CornerRadius="14" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                        Padding="18" Margin="6">
                    <StackPanel>
                        <TextBlock Text="🔒 100% Private" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4" />
                        <TextBlock Text="Your game data stays on your device. No accounts, tracking, or telemetry."
                                   FontSize="13" Foreground="#64748B" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border CornerRadius="14" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                        Padding="18" Margin="6">
                    <StackPanel>
                        <TextBlock Text="🤖 Smart AI Bots" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4" />
                        <TextBlock Text="Play solo against intelligent computer opponents or pass-and-play with friends."
                                   FontSize="13" Foreground="#64748B" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Footer Links Bar -->
            <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,20,0,0" Margin="0,10,0,0">
                <WrapPanel HorizontalAlignment="Center">
                    <TextBlock Text="💼 " VerticalAlignment="Center" />
                    <TextBlock Text="Portfolio" Foreground="#0284C7" FontWeight="SemiBold" Cursor="Hand"
                               MouseLeftButtonDown="OnPortfolioClicked" Margin="0,0,16,6" />

                    <TextBlock Text="🤝 " VerticalAlignment="Center" />
                    <TextBlock Text="Support" Foreground="#0284C7" FontWeight="SemiBold" Cursor="Hand"
                               MouseLeftButtonDown="OnSupportClicked" Margin="0,0,16,6" />

                    <TextBlock Text="☕ " VerticalAlignment="Center" />
                    <TextBlock Text="Donate" Foreground="#0284C7" FontWeight="SemiBold" Cursor="Hand"
                               MouseLeftButtonDown="OnDonateClicked" Margin="0,0,16,6" />

                    <TextBlock Text="📜 " VerticalAlignment="Center" />
                    <TextBlock Text="Terms of Services" Foreground="#0284C7" FontWeight="SemiBold" Cursor="Hand"
                               MouseLeftButtonDown="OnTermsClicked" Margin="0,0,16,6" />

                    <TextBlock Text="🔒 " VerticalAlignment="Center" />
                    <TextBlock Text="Privacy Policy" Foreground="#0284C7" FontWeight="SemiBold" Cursor="Hand"
                               MouseLeftButtonDown="OnPrivacyClicked" Margin="0,0,16,6" />
                </WrapPanel>
            </Border>
            
            <TextBlock Text="Pak Ludo v1.0.1 • Crafted by Muhammad Adrees" FontSize="12" Foreground="#94A3B8"
                       HorizontalAlignment="Center" Margin="0,12,0,0" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
